# Токен бота від @BotFather (Telegram)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# HTTPS-домен, на якому доступний цей сервер (ngrok, VPS з SSL тощо).
# Telegram WebApp-кнопки працюють ТІЛЬКИ з https-посиланнями.
WEB_APP_URL=https://your-domain.example.com

# Порт локального сервера (необов'язково)
PORT=3000

# Дозволити тестування WebApp поза Telegram без перевірки підпису (лише для локальної розробки!)
# У проді / для реальних друзів завжди залишай false.
ALLOW_UNVERIFIED_DEV=false

# Telegram id власника бота (дізнатись: @userinfobot). Сюди приходять фото від
# гравців і сповіщення про нові скарги. Порожнє значення = фічі вимкнені.
OWNER_TELEGRAM_ID=

# Пароль входу в адмін-панель (/admin) — окремий від BOT_TOKEN навмисно, щоб
# витік одного секрету не давав доступу до іншого. Якщо не задати — адмінка
# впаде назад на BOT_TOKEN (як було раніше), тому для реального проду
# обов'язково постав власний пароль тут.
ADMIN_PASSWORD=
